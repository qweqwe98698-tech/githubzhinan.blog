---
// A drawing of the developer reference in rules and mono text rather than a screenshot:
// stays sharp at any width, matches dark mode automatically, and loads zero external assets.
const query = 'architecture AND tag:open-source';
const hits = [
  {
    path: 'core/engine/pipeline.go',
    line: 104,
    before: 'func (p *Pipeline) ',
    match: 'Execute',
    after: '(ctx context.Context) error { return p.run() }',
  },
  {
    path: 'docs/guides/zero-allocation.md',
    line: 42,
    before: 'optimize buffer reuse with ',
    match: 'sync.Pool',
    after: ' under high concurrency',
  },
  {
    path: 'workflows/ci-deploy.yaml',
    line: 18,
    before: 'run: pnpm build && ',
    match: 'audit',
    after: ' --strict --production',
  },
];
---

<figure class="border-border border">
  <div class="border-border text-faint flex flex-wrap items-baseline gap-x-2 border-b px-3 py-2 font-mono text-[11px]">
    <span class="text-foreground">zhinan</span>
    <span>query</span>
    <span class="text-primary">"{query}"</span>
  </div>

  <ol class="font-mono text-[11px] leading-relaxed">
    {hits.map((hit) => (
      <li class="border-border border-b px-3 py-2.5 last:border-b-0">
        <p class="text-faint flex justify-between gap-3">
          <span class="truncate">{hit.path}</span>
          <span>:{hit.line}</span>
        </p>
        <p class="mt-1 truncate">
          {hit.before}
          <mark>{hit.match}</mark>
          {hit.after}
        </p>
      </li>
    ))}
  </ol>

  <figcaption class="border-border text-faint border-t px-3 py-2 font-mono text-[11px]">
    3 of 280 modules · verified on production · 0 broken links
  </figcaption>
</figure>
