---
// Three link groups from src/config.ts, then one mono line. The group headings use the
// same mono label as the marginal index, which is the only label style in the theme.
import { Icon } from 'astro-icon/components';
import { nav, site, ui } from '../../config';

const year = new Date().getUTCFullYear();
---

<footer class="border-border mt-24 border-t">
  <div class="shell py-12">
    <div class="grid gap-x-8 gap-y-9 sm:grid-cols-3">
      {nav.footer.map((group) => (
        <div>
          <h2 class="text-faint font-mono text-[11px] tracking-[0.13em] uppercase">
            {group.title}
          </h2>
          <ul class="mt-3 space-y-1.5 text-sm">
            {group.links.map((link) => (
              <li>
                <a class="text-muted hover:text-foreground no-underline" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-border text-faint mt-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t pt-6 font-mono text-[11px]">
      <p>
        © {year} {site.name} · 保留所有权利
      </p>
      <ul class="flex items-center gap-4">
        {nav.social.map((item) => (
          <li>
            <a
              class="hover:text-foreground no-underline"
              href={item.href}
              target="_blank"
              rel="nofollow noopener noreferrer"
            >
              <Icon name={item.icon} class="size-4" aria-hidden="true" />
              <span class="sr-only">{item.label}</span>
            </a>
          </li>
        ))}
        <li>
          <a class="hover:text-foreground no-underline" href="/rss.xml">
            {ui.rss}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
