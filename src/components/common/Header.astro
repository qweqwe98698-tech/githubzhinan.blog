---
// Sticky, one hairline, no dropdown. Four links and a call to action fit on one row
// at 640px and wrap to a second row below it, which is cheaper than a menu that
// needs script to open.
import { features, nav, site, ui } from '../../config';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
// In-page links (/#how) are not a destination, so they never claim the current page.
const isCurrent = (href: string) =>
  !href.includes('#') && (href === path || path.startsWith(`${href}/`));
---

<header class="bg-background border-border sticky top-0 z-40 border-b">
  <div class="shell flex flex-wrap sm:flex-nowrap items-center justify-between gap-x-4 py-2.5">
    <a href="/" class="font-ui text-base font-semibold tracking-[-0.028em] no-underline flex items-center gap-2 shrink-0">
      <img src="/favicon.svg" alt="" class="w-5 h-5 shrink-0" />
      <span>{site.name}</span>
    </a>

    <nav aria-label={ui.mainNav} class="order-last sm:order-none w-full sm:w-auto overflow-x-auto sm:overflow-visible pt-2 sm:pt-0 border-t sm:border-t-0 border-border/40">
      <ul class="flex items-center gap-x-3.5 md:gap-x-4 text-xs sm:text-[13px] whitespace-nowrap">
        {nav.header.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="text-muted hover:text-foreground aria-[current=page]:text-foreground no-underline font-medium"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2.5 shrink-0">
      {features.darkMode && <ThemeToggle />}
      <a href={nav.cta.href} class="btn btn--quiet whitespace-nowrap text-xs py-1 px-2.5">
        {nav.cta.label}
      </a>
    </div>
  </div>
</header>
