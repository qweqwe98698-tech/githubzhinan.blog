const faqs = [
  {
    q: '为什么有些机场标称价格低至每月几元，而高端专线需要二三十元？',
    a: '价格差距的根源在于底层物理带宽成本与超卖比。每月几元的廉价机场使用的是公共公网海缆出口或者合租的廉价 VPS，晚高峰期间成百上千人抢占几百兆公网出口，丢包率往往高达 30% 以上，且 IP 极易被 OpenAI 等服务批量封杀。而每月二十多元的 IEPL 专线租用持牌运营商独立的物理陆缆内网，不走公共国际公网出口，晚高峰丢包率为零，并配备专有原生机房 IP，单兆带宽成本是前者的数十倍。',
  },
  {
    q: '购买机场套餐时，选择“月付”还是“年付”更划算？',
    a: '对于初次接触的新品牌，第一准则永远是先买一个月进行实测。跨境网络环境复杂，不同地区、不同宽带（电信、联通、移动）在晚高峰的体验差异极大。只有在连续使用满一个月、确认本地网络晚高峰平直稳定之后，再结合年付优惠（如光速云轻量版年付折合仅 8 元/月）进行长期订阅。切忌在没有任何实际测试的情况下盲目购买不知名小机场的多年大包。',
  },
  {
    q: '套餐内的流量是按什么规则计算的，倍率节点是什么意思？',
    a: '正规机场以用户实际产生的上传与下载数据量之和计算流量消耗。但必须特别注意节点的倍率参数。如果某个特殊高速专线节点标记为 2.0x 倍率，意味着你下载 1GB 文件，系统会在后台扣除 2GB 套餐额度。反之，标记为 0.5x 的节点下载 1GB 只扣除 500MB。在选购时不仅要看标称总流量，还要确认主力节点是否为标准的 1.0x 倍率。',
  },
  {
    q: '光速云的 147 元 247GB 永久套餐和普通月付套餐相比有什么优势？',
    a: '普通月付套餐的额度在每个计费周期（30天）结束时会自动清零，未用完的流量无法累积，对于每个月仅出差几天或偶尔查资料的用户来说存在明显的隐形浪费。光速云致敬斯诺克 147 元套餐属于一次性买断性质，终身不过期且不限设备数量，只要 247GB 额度未耗尽就可以一直使用，同时享有光速云顶级的 IEPL 专线与全球节点速度，非常适合作为高可靠的长期备用梯子。',
  },
  {
    q: '为什么有些服务商不支持微信或支付宝，只支持 USDT 等虚拟货币？',
    a: '支持支付宝与微信直接付款的服务商，通常接入了合规的第三方跨境商业支付网关，具备较高的运营成本与商业实体门槛，跑路风险相对较低。而仅支持加密货币支付的平台匿名性极强，一旦发生机房变故或运营方跑路，用户在现实中没有任何追索或争议退款途径。建议普通个人用户优先选择支持主流便捷移动支付渠道的品牌。',
  },
  {
    q: '套餐标注的“同时在线设备数”是如何判定的？',
    a: '节点服务器通过统计同一订阅在短时间内的不同公共 IP 来源或并发 TCP 会话数来判定设备数量。如果套餐限制 2 台设备，意味着如果你同时在手机、笔记本和台式机三端开启代理并发起网络请求，第三台设备可能会遭遇连接被拒或降速。家庭或小型研发团队多设备共用时，应优先选择明确标注不限制在线设备的套餐。',
  },
  {
    q: '如果套餐流量在月度结算日前用完了怎么办？',
    a: '大部分规范运营的机场允许用户在控制台以原价提前重置套餐周期，或者单独购买临时的按量流量叠加包。极少数低质机场在流量用尽后会直接完全断网且无法充值。在选购时可以提前在控制台确认是否具备流量重置与工单自动响应功能。',
  },
  {
    q: '为什么使用国外大模型时，部分节点即使有网也频繁提示 Access Denied？',
    a: '这是由于节点海外出口的 IP 纯净度不达标造成的。OpenAI 与 Anthropic 会接入第三方商业安全威胁情报库，将大型共享数据中心的公网 IP 批量列入风控名单。解决该问题需要认准带有原生住宅或独享纯净出口的专线节点，并在客户端开启虚拟网卡 TUN 模式杜绝本地 IPv6 与 DNS 泄漏。',
  },
];

const pageTitle = '2026 机场价格方案大表与场景选型决策矩阵 · GitHub 指南';
const pageDescription = '深度剖析 42 家机场价格梯度：从月付 5.6 元极低门槛、25 元旗舰 IEPL 专线，到 147 元不过期买断包与企业独享定制，提供真实成本拆解与科学选型指南。';

const jsonLd = [
  {
    '@type': 'WebPage',
    name: pageTitle,
    description: pageDescription,
    url: 'https://githubzhinan.blog/pricing/',
  },
  {
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];
---

<Base title={pageTitle} description={pageDescription} jsonLd={jsonLd}>
  <div class="shell">
    <!-- Header Hero -->
    <div class="shell-body pt-14 pb-12 sm:pt-20">
      <nav aria-label="面包屑" class="font-mono text-[11px] text-faint flex items-center gap-2 mb-4">
        <a href="/" class="hover:text-foreground no-underline">首页</a>
        <span>/</span>
        <span class="text-foreground">场景选型决策矩阵</span>
      </nav>

      <p class="text-faint font-mono text-[11px]">
        4 档主流价位 · 5 大应用场景 · 拒绝盲目消费 · 真实网络成本透明拆解
      </p>
      <h1 class="mt-3 text-3xl font-medium tracking-[-0.028em] sm:text-4xl text-foreground">
        2026 机场价格阶梯与场景选型决策矩阵
      </h1>
      <p class="text-muted mt-4 text-base sm:text-lg leading-relaxed">
        买机场不是越贵越好，也不是越便宜越赚，关键在于底层网络架构是否精准匹配您的实际工作流。
        重度依赖 GitHub Copilot 与 ChatGPT 的研发人员需要零丢包的原生专线，轻度文献检索的学者只需入门中转，而常年差旅者则更适合不设过期时限的买断大包。
        本篇决策专著基于我们对市场上 42 家主流机场的深度测速与套餐审计，为您全面理清每分钱背后的真实网络价值。
      </p>

      <!-- Quick Decision Verdict Bar (Module 1: Direct Answer at the Top) -->
      <div class="border-border mt-8 p-5 border bg-surface/40 rounded-[2px] font-mono text-xs">
        <span class="text-primary font-semibold flex items-center gap-2">
          <span>⚡</span> 30 秒省流直通结论
        </span>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-3">
          <div class="border-border border p-3 bg-background">
            <span class="text-faint text-[10px]">主力开发 / AI办公首选</span>
            <p class="font-bold text-foreground text-sm mt-1">光速云 · 极速专线版</p>
            <p class="text-muted text-[11px] mt-1">¥25/月 (168GB) · IEPL专线 · 原生免风控</p>
            <a href="/brands/guangsu" class="text-primary text-[11px] underline block mt-2">查看实测报告 &rarr;</a>
          </div>
          <div class="border-border border p-3 bg-background">
            <span class="text-faint text-[10px]">差旅备用 / 永不过期</span>
            <p class="font-bold text-foreground text-sm mt-1">光速云 · 致敬斯诺克</p>
            <p class="text-muted text-[11px] mt-1">¥147 一次性买断 (247GB) · 终身不限时</p>
            <a href="/brands/guangsu#plans" class="text-primary text-[11px] underline block mt-2">直达买断方案 &rarr;</a>
          </div>
          <div class="border-border border p-3 bg-background">
            <span class="text-faint text-[10px]">极致性价比 / 预算无忧</span>
            <p class="font-bold text-foreground text-sm mt-1">闪电鼠 / 大佬云</p>
            <p class="text-muted text-[11px] mt-1">低至 ¥5.6/月起 · 50G基础流量 · 轻量科研</p>
            <a href="/brands/shandianshu" class="text-primary text-[11px] underline block mt-2">查看入门详情 &rarr;</a>
          </div>
          <div class="border-border border p-3 bg-background">
            <span class="text-faint text-[10px]">跨境电商 / 团队直播</span>
            <p class="font-bold text-foreground text-sm mt-1">企业独享固定原生 IP</p>
            <p class="text-muted text-[11px] mt-1">¥680/月 · 独享专属出口 · 防关联风控</p>
            <a href="/brands/guangsu#plans" class="text-primary text-[11px] underline block mt-2">查看企业配置 &rarr;</a>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Marginal Index Sections -->
    <div class="rail border-border border-t pt-14">

      <!-- Section 1: Tier Overview Cards -->
      <Section label="梯队对比" id="tiers">
        <h2 class="text-2xl font-medium tracking-tight">4 档主流预算梯度深度横向横评</h2>
        <p class="text-muted mt-2 text-sm leading-relaxed">
          市场上的 42 家机场可以清晰地划分为四种截然不同的商业与技术形态。请根据您的财务预期与业务容忍度对号入座：
        </p>

        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
          {tiers.map((t) => (
            <article
              id={t.id}
              class:list={[
                'border-border border p-6 font-mono text-xs flex flex-col justify-between transition-all rounded-[2px]',
                t.featured ? 'bg-surface/50 border-primary ring-1 ring-primary/30' : 'bg-background hover:border-foreground/30',
              ]}
            >
              <div>
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <h3 class="text-lg font-bold text-foreground">{t.name}</h3>
                    {t.featured && (
                      <span class="bg-primary text-on-primary px-2 py-0.5 text-[10px] font-semibold rounded-[2px]">
                        综合首推
                      </span>
                    )}
                  </div>
                </div>

                <div class="mt-3 flex items-baseline gap-1">
                  <span class="text-3xl font-bold text-foreground">{t.price}</span>
